{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "config.schema.json",
  "title": "Whiteboard engine configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project",
    "languages",
    "voice",
    "transcription",
    "video",
    "animation",
    "planner",
    "quality",
    "automation"
  ],
  "properties": {
    "project": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "mode": {
          "enum": [
            "supplied_content",
            "automatic_topic"
          ]
        },
        "output_directory": {
          "type": "string"
        },
        "temporary_directory": {
          "type": "string"
        }
      }
    },
    "languages": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "english": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "script_path",
            "audio_path",
            "script_language",
            "caption_language"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "script_path": {
              "type": "string"
            },
            "audio_path": {
              "type": "string"
            },
            "script_language": {
              "enum": [
                "en",
                "ur",
                "roman_urdu",
                "ps",
                "ps_latn"
              ]
            },
            "caption_language": {
              "enum": [
                "en",
                "ur",
                "roman_urdu",
                "ps",
                "ps_latn"
              ]
            }
          }
        },
        "urdu": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "script_path",
            "audio_path",
            "script_language",
            "caption_language"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "script_path": {
              "type": "string"
            },
            "audio_path": {
              "type": "string"
            },
            "script_language": {
              "enum": [
                "en",
                "ur",
                "roman_urdu",
                "ps",
                "ps_latn"
              ]
            },
            "caption_language": {
              "enum": [
                "en",
                "ur",
                "roman_urdu",
                "ps",
                "ps_latn"
              ]
            }
          }
        },
        "roman_urdu": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "script_path",
            "audio_path",
            "script_language",
            "caption_language"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "script_path": {
              "type": "string"
            },
            "audio_path": {
              "type": "string"
            },
            "script_language": {
              "enum": [
                "en",
                "ur",
                "roman_urdu",
                "ps",
                "ps_latn"
              ]
            },
            "caption_language": {
              "enum": [
                "en",
                "ur",
                "roman_urdu",
                "ps",
                "ps_latn"
              ]
            }
          }
        },
        "pashto": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "script_path",
            "audio_path",
            "script_language",
            "caption_language"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "script_path": {
              "type": "string"
            },
            "audio_path": {
              "type": "string"
            },
            "script_language": {
              "enum": [
                "en",
                "ur",
                "roman_urdu",
                "ps",
                "ps_latn"
              ]
            },
            "caption_language": {
              "enum": [
                "en",
                "ur",
                "roman_urdu",
                "ps",
                "ps_latn"
              ]
            }
          }
        }
      }
    },
    "voice": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "generate_missing": {
          "type": "boolean"
        },
        "transcribe_missing_scripts": {
          "type": "boolean"
        },
        "prefer_supplied_audio": {
          "type": "boolean"
        },
        "allow_online_free_tts": {
          "type": "boolean"
        },
        "allow_local_tts": {
          "type": "boolean"
        },
        "allow_wrong_language_fallback": {
          "type": "boolean"
        },
        "online_providers": {
          "type": "array",
          "items": {
            "enum": [
              "edge_tts"
            ]
          }
        },
        "local_engines": {
          "type": "array",
          "items": {
            "enum": [
              "piper",
              "mms",
              "espeak"
            ]
          }
        },
        "allow_noncommercial_models": {
          "type": "boolean"
        },
        "sentence_pause_seconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 3
        },
        "piper_voices": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "mms_models": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "espeak_voices": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "edge_voices": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "clone": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "enum": [
                "auto",
                true,
                false
              ]
            },
            "reference_path": {
              "type": "string"
            },
            "engine": {
              "enum": [
                "omnivoice",
                "openvoice",
                "none"
              ]
            },
            "tau": {
              "type": "number",
              "minimum": 0.05,
              "maximum": 1.0
            },
            "max_duration_change": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.5
            },
            "omnivoice_model": {
              "type": "string"
            },
            "omnivoice_steps": {
              "type": "integer",
              "minimum": 4,
              "maximum": 64
            },
            "reference_text": {
              "type": "string"
            },
            "omnivoice_languages": {
              "type": "array",
              "items": {
                "enum": [
                  "en",
                  "ur",
                  "ps"
                ]
              }
            }
          }
        },
        "paragraph_pause_seconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 3
        }
      }
    },
    "transcription": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "engine": {
          "enum": [
            "faster_whisper",
            "none"
          ]
        },
        "model": {
          "type": "string"
        },
        "compute_type": {
          "type": "string"
        },
        "minimum_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "video": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "aspect_ratio": {
          "enum": [
            "9:16"
          ]
        },
        "width": {
          "type": "integer",
          "minimum": 240,
          "maximum": 4320
        },
        "height": {
          "type": "integer",
          "minimum": 240,
          "maximum": 7680
        },
        "fps": {
          "type": "integer",
          "minimum": 10,
          "maximum": 60
        },
        "codec": {
          "enum": [
            "libx264"
          ]
        },
        "audio_codec": {
          "enum": [
            "aac"
          ]
        },
        "audio_bitrate": {
          "type": "string"
        },
        "audio_sample_rate": {
          "enum": [
            44100,
            48000
          ]
        },
        "maximum_duration_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "allow_longer_than_maximum": {
          "type": "boolean"
        },
        "captions_enabled": {
          "type": "boolean"
        },
        "background_music_enabled": {
          "type": "boolean"
        },
        "background_music_path": {
          "type": "string"
        },
        "background_music_volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "intro_seconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "outro_seconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "quality": {
          "enum": [
            "fast",
            "standard",
            "high"
          ]
        },
        "output_format": {
          "enum": [
            "shorts_9_16"
          ]
        }
      }
    },
    "animation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "style": {
          "enum": [
            "whiteboard"
          ]
        },
        "background": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "primary_stroke": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "accent_color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "positive_color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "negative_color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "stroke_width": {
          "type": "number",
          "minimum": 1,
          "maximum": 30
        },
        "hand_cursor_enabled": {
          "type": "boolean"
        },
        "hand_cursor_style": {
          "enum": [
            "hand",
            "marker"
          ]
        },
        "hand_cursor_scale": {
          "type": "number",
          "minimum": 0.3,
          "maximum": 3
        },
        "semantic_scene_planning": {
          "type": "boolean"
        },
        "progressive_strokes": {
          "type": "boolean"
        },
        "drawing_speed": {
          "type": "number",
          "minimum": 0.25,
          "maximum": 4
        },
        "seed": {
          "type": "integer"
        },
        "drawing_density": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        }
      }
    },
    "planner": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_scene_seconds": {
          "type": "number",
          "minimum": 2,
          "maximum": 30
        },
        "min_scene_seconds": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 10
        },
        "local_llm": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "endpoint": {
              "type": "string"
            },
            "model": {
              "type": "string"
            }
          }
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minimum_successful_scenes": {
          "type": "integer",
          "minimum": 1
        },
        "maximum_plan_validation_errors": {
          "type": "integer",
          "minimum": 0
        },
        "maximum_caption_overflow": {
          "type": "integer",
          "minimum": 0
        },
        "maximum_unsupported_characters": {
          "type": "integer",
          "minimum": 0
        },
        "maximum_blank_frame_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "maximum_duration_mismatch_seconds": {
          "type": "number",
          "minimum": 0
        },
        "minimum_audio_peak_db": {
          "type": "number"
        },
        "frame_samples_per_scene": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        }
      }
    },
    "automation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "automatic_topic_discovery": {
          "type": "boolean"
        },
        "topic_feeds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "topic_languages": {
          "type": "array",
          "items": {
            "enum": [
              "english",
              "urdu",
              "roman_urdu",
              "pashto"
            ]
          }
        },
        "retry_limit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "retry_base_seconds": {
          "type": "number",
          "minimum": 0
        },
        "download_timeout_seconds": {
          "type": "number",
          "minimum": 1
        },
        "subprocess_timeout_seconds": {
          "type": "number",
          "minimum": 10
        },
        "continue_on_language_failure": {
          "type": "boolean"
        },
        "upload_artifacts": {
          "type": "boolean"
        },
        "artifact_retention_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 90
        },
        "target_languages": {
          "oneOf": [
            {
              "const": "auto"
            },
            {
              "type": "array",
              "items": {
                "enum": [
                  "english",
                  "urdu",
                  "roman_urdu",
                  "pashto"
                ]
              }
            }
          ]
        },
        "minimum_free_disk_mb": {
          "type": "integer",
          "minimum": 0
        },
        "resume": {
          "type": "boolean"
        }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "forced_alignment": {
          "type": "boolean"
        },
        "min_pause_seconds": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 2
        }
      }
    }
  }
}
